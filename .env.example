# Copie para .env e preencha. Nunca versione o .env.

# Banco (o compose monta a DATABASE_URL sozinho a partir destes 3).
# Use senha sem caracteres especiais (@ : / #) para não quebrar a URL.
POSTGRES_USER=invest
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=invest
# Referência: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@db:5432/POSTGRES_DB
# Para usar Supabase, defina DATABASE_URL aqui com a string de conexão dele
# (o compose usa este valor se existir).
# DATABASE_URL=postgresql://usuario:senha@host-do-supabase:5432/postgres

# IA
GROQ_API_KEY=sua_chave_groq_aqui

# E-mail dos alertas
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=senha_smtp
SMTP_FROM=alertas@exemplo.com

# Porta externa do app sem domínio (padrão 8501). Use outra se só ela estiver liberada no painel da Oracle.
APP_PORT=8501

# HTTPS: deixe vazio para acessar por http://IP:8501.
# Com domínio (DNS apontando para a VPS), o Caddy emite o certificado.
DOMINIO=

# Intervalo do job de alertas em minutos (1440 = 1 vez por dia)
ALERTA_INTERVALO_MIN=1440
